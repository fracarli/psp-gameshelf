@@ -51,6 +51,14 @@ u32 option_clock_speed = PSP_CLOCK_333;
 
 char main_path[MAX_PATH];
 
+/*
+ * GameShelf integration build:
+ * the PSP loader can preserve an unexpected current working directory when
+ * an EBOOT is launched from another homebrew.  Keep all TempGBA assets in a
+ * deterministic directory instead of deriving the path from getcwd().
+ */
+#define GAMESHELF_RUNTIME_PATH "ms0:/PSP/GAME/GAMESHELF/TempGBA/"
+
 int date_format = 0;
 u32 enable_home_menu = 1;
 
@@ -709,15 +717,18 @@ static int load_ku_bridge_prx(int devkit_version)
 
 static void load_setting_cfg(void)
 {
-  char filename[MAX_FILE];
-
-  sprintf(filename, "%sdir.ini", main_path);
-
-  if (load_dir_cfg(filename) < 0)
-  {
-    sprintf(filename, MSG[MSG_ERR_LOAD_DIR_INI], main_path);
-    //error_msg(filename, CONFIRMATION_CONT);
-  }
+  /*
+   * GameShelf integration build: do not depend on the legacy dir.ini parser.
+   * That parser validates every directory with sceIoDopen(), which is
+   * unreliable during a cross-EBOOT hand-off on some PSP storage setups.
+   * The paths are fixed, valid directories created by GameShelf before launch.
+   */
+  strcpy(dir_roms,  GAMESHELF_RUNTIME_PATH "roms/");
+  strcpy(dir_save,  GAMESHELF_RUNTIME_PATH "save/");
+  strcpy(dir_state, GAMESHELF_RUNTIME_PATH "state/");
+  strcpy(dir_cfg,   GAMESHELF_RUNTIME_PATH "cfg/");
+  strcpy(dir_snap,  GAMESHELF_RUNTIME_PATH "snapshot/");
+  strcpy(dir_cheat, GAMESHELF_RUNTIME_PATH "cheats/");
 }
 
