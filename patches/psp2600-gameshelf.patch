diff --git a/src/psp_no_ir.c b/src/psp_no_ir.c
new file mode 100644
--- /dev/null
+++ b/src/psp_no_ir.c
@@ -0,0 +1,10 @@
+/* The SDK SDL build references optional PSP-1000 infrared keyboard hooks.
+ * This PSP-3000 adapter has no infrared keyboard; report unavailable so SDL
+ * retains its ordinary controller input without an external IR dependency. */
+int pspIrKeybInit(const char *config, int kernelmode)
+{ (void)config; (void)kernelmode; return -1; }
+int pspIrKeybOutputMode(int mode)
+{ (void)mode; return -1; }
+int pspIrKeybReadinput(void *buffer, int *length)
+{ (void)buffer; if(length)*length=0; return -1; }
+int pspIrKeybFinish(void) { return 0; }
